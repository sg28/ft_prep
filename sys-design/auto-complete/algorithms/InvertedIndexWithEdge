

function edgeNgrams(term) {
  const grams = [];
  for (let i = 1; i <= term.length; i++) grams.push(term.slice(0, i));
  return grams;
}

class NgramIndex {
  constructor() {
    this.map = new Map();
  }
  add(term, id) {
    for (const g of edgeNgrams(term)) {
      const key = `name|en|${g}|v3`; // shaped key
      if (!this.map.has(key)) this.map.set(key, new Set());
      this.map.get(key).add(id);
    }
  }
  lookup(prefix) {
    return Array.from(this.map.get(`name|en|${prefix}|v3`) ?? []);
  }
}
// usage
const idx = new NgramIndex();
["apple", "application", "appetite"].forEach((w, i) => idx.add(w, i));
console.log(idx.lookup("app")); // [0,1,2]
