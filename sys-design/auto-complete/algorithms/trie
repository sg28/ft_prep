class Trie {
  constructor() {
    this.root = {};
    this.term = Symbol("term");
  }
  insert(word, payload) {
    let n = this.root;
    for (const ch of word) n = n[ch] ??= {};
    n[this.term] = payload ?? true;
  }
  // Collect descendants under node with cutoff
  _collect(n, out, K) {
    if (!n || out.length >= K) return;
    if (n[this.term]) out.push(n[this.term]);
    for (const k of Object.keys(n))
      if (k !== this.term && out.length < K) this._collect(n[k], out, K);
  }
  // Prefix search
  search(prefix, K = 20) {
    let n = this.root;
    for (const ch of prefix) {
      n = n[ch];
      if (!n) return [];
    }
    const out = [];
    this._collect(n, out, K);
    return out;
  }
}
// usage
const trie = new Trie();
["apple", "application", "appetite"].forEach((w) =>
  trie.insert(w, { id: w, name: w })
);
console.log(trie.search("app", 10)); // Top candidates
