function editDistance(a, b) {
  const m = a.length,
    n = b.length,
    dp = Array.from({ length: m + 1 }, (_, i) => Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) dp[i][0] = i;
  for (let j = 0; j <= n; j++) dp[0][j] = j;
  for (let i = 1; i <= m; i++)
    for (let j = 1; j <= n; j++) {
      const c = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i][j] = Math.min(
        dp[i - 1][j] + 1,
        dp[i][j - 1] + 1,
        dp[i - 1][j - 1] + c
      );
    }
  return dp[m][n];
}

function fuzzyRecall(dict, query, maxEd = 1, cap = 200) {
  const out = [];
  for (const e of dict) {
    if (out.length >= cap) break;
    if (editDistance(query, e.name) <= maxEd) out.push(e);
  }
  return out;
}
// usage
const dict = ["apple", "apply", "applet", "ape"].map((w) => ({
  id: w,
  name: w,
}));
console.log(fuzzyRecall(dict, "applw", 1, 50)); // recovers "apple","apply","applet"
