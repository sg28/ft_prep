#!/usr/bin/env python3
"""
pdf_to_md.py — Convert PDF file(s) to Markdown.

Usage:
    python3 pdf_to_md.py file.pdf [file2.pdf ...]
    python3 pdf_to_md.py --dir /path/to/folder [--out /path/to/output]
    python3 pdf_to_md.py --dir . --recursive

Output: r&d/converted-md/<name>.md  (or --out <dir> to override).

Requires: pymupdf (pip install pymupdf), pdfplumber (pip install pdfplumber)
"""

from __future__ import annotations

import argparse
import re
import sys
from collections import Counter
from pathlib import Path

try:
    import pymupdf as fitz
except ImportError:
    import fitz

import pdfplumber


# ---------------------------------------------------------------------------
# Text cleaning
# ---------------------------------------------------------------------------

# Zero-width and invisible Unicode characters to strip from all text
_INVISIBLE = re.compile(r"[​‌‍\u200E\u200F﻿­⁠]")
# Page-number / copyright footer patterns common in PDFs
_FOOTER_RE = re.compile(
    r"^(page\s+\d+(\s+of\s+\d+)?|©.{0,80}|\d+\s*/\s*\d+)$",
    re.IGNORECASE,
)


def _clean(text: str) -> str:
    text = _INVISIBLE.sub("", text)
    text = re.sub(r"[ \t]+", " ", text)
    return text.strip()


# ---------------------------------------------------------------------------
# Repeating header / footer detection
# ---------------------------------------------------------------------------

def _find_repeating_lines(fitz_doc) -> set[str]:
    """Return line texts that appear on > 40 % of pages (headers / footers)."""
    n = len(fitz_doc)
    if n < 2:
        return set()

    counts: Counter = Counter()
    for page_num in range(n):
        page = fitz_doc[page_num]
        blocks = page.get_text("dict")["blocks"]
        seen_this_page: set[str] = set()
        for block in blocks:
            if block.get("type") != 0:
                continue
            for line in block.get("lines", []):
                line_text = _clean(
                    " ".join(
                        span.get("text", "")
                        for span in line.get("spans", [])
                    )
                )
                if line_text and line_text not in seen_this_page:
                    counts[line_text] += 1
                    seen_this_page.add(line_text)

    threshold = max(2, n * 0.4)
    return {t for t, c in counts.items() if c >= threshold}


# ---------------------------------------------------------------------------
# Font / heading helpers
# ---------------------------------------------------------------------------

def _heading_level(size: float, body_size: float) -> int:
    ratio = size / body_size if body_size else 1.0
    if ratio >= 1.6:
        return 1
    if ratio >= 1.3:
        return 2
    if ratio >= 1.1:
        return 3
    return 0


def _dominant_body_size(page_blocks: list) -> float:
    sizes: dict[float, int] = {}
    for block in page_blocks:
        if block.get("type") != 0:
            continue
        for line in block.get("lines", []):
            for span in line.get("spans", []):
                s = round(span.get("size", 0), 1)
                sizes[s] = sizes.get(s, 0) + len(span.get("text", ""))
    return max(sizes, key=sizes.get) if sizes else 12.0


# ---------------------------------------------------------------------------
# Table rendering
# ---------------------------------------------------------------------------

def _table_to_md(table: list[list]) -> str:
    if not table:
        return ""
    # Normalise cells: strip invisible chars, collapse internal newlines to space
    rows = [
        [_clean(re.sub(r"\s*\n\s*", " ", str(c))) if c else "" for c in row]
        for row in table
    ]
    col_count = max(len(r) for r in rows)
    rows = [r + [""] * (col_count - len(r)) for r in rows]

    widths = [max(len(r[i]) for r in rows) for i in range(col_count)]
    widths = [max(w, 3) for w in widths]

    def fmt_row(row):
        return "| " + " | ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)) + " |"

    header = fmt_row(rows[0])
    separator = "| " + " | ".join("-" * widths[i] for i in range(col_count)) + " |"
    body = "\n".join(fmt_row(r) for r in rows[1:])
    return "\n".join(filter(None, [header, separator, body]))


def _col_count_of_md_table(block: str) -> int:
    """Return column count of a Markdown table block, or 0 if not a table."""
    lines = [l for l in block.strip().splitlines() if l.startswith("|")]
    if len(lines) < 2:
        return 0
    return lines[0].count("|") - 1


def _merge_split_tables(blocks: list[str]) -> list[str]:
    """Merge Markdown tables with the same column count, skipping page separators between them."""
    out: list[str] = []
    i = 0
    while i < len(blocks):
        cols = _col_count_of_md_table(blocks[i])
        if cols > 0:
            merged_lines = blocks[i].strip().splitlines()
            j = i + 1
            while j < len(blocks):
                b = blocks[j]
                if b.strip() == "---":
                    # Peek past separator(s) to see if next real block is a same-column table
                    k = j + 1
                    while k < len(blocks) and blocks[k].strip() == "---":
                        k += 1
                    if k < len(blocks) and _col_count_of_md_table(blocks[k]) == cols:
                        j = k  # jump to continuation table, drop the separator
                        continue
                    else:
                        break
                if _col_count_of_md_table(b) == cols:
                    next_lines = b.strip().splitlines()
                    # Line 0 = "header" of continuation (actually the first data row)
                    # Line 1 = separator  → always drop
                    # Line 2+ = remaining data rows
                    merged_lines.append(next_lines[0])
                    merged_lines += next_lines[2:]
                    j += 1
                else:
                    break
            out.append("\n".join(merged_lines))
            i = j
        else:
            out.append(blocks[i])
            i += 1
    return out


# ---------------------------------------------------------------------------
# Bbox overlap
# ---------------------------------------------------------------------------

def _bbox_overlaps(b1, b2, tolerance: float = 2.0) -> bool:
    return not (
        b1[3] + tolerance < b2[1] or b2[3] + tolerance < b1[1]
        or b1[2] + tolerance < b2[0] or b2[2] + tolerance < b1[0]
    )


def _page_links(fitz_page) -> list[tuple]:
    """Return [(rect_tuple, uri), ...] for external hyperlinks on a page."""
    out = []
    for link in fitz_page.get_links():
        uri = link.get("uri")
        if uri and link.get("from") is not None:
            r = link["from"]
            out.append(((r.x0, r.y0, r.x1, r.y1), uri))
    return out


_ADJ_LINK_RE = re.compile(
    r"\[([^\]]*)\]\((https?://[^\s)]+)\)[ \t]*\n\[([^\]]*)\]\(\2\)"
)


def _merge_adjacent_links(text: str) -> str:
    """Join link fragments split across a line break that share the same URI."""
    prev = None
    while prev != text:
        prev = text
        text = _ADJ_LINK_RE.sub(
            lambda m: f"[{m.group(1)} {m.group(3)}]({m.group(2)})", text
        )
    return text


def _link_for_span(span_bbox, links: list[tuple]) -> str | None:
    """Return the URI whose rect contains this span's center, or None."""
    if not span_bbox or not links:
        return None
    cx = (span_bbox[0] + span_bbox[2]) / 2
    cy = (span_bbox[1] + span_bbox[3]) / 2
    for (r, uri) in links:
        if r[0] <= cx <= r[2] and r[1] <= cy <= r[3]:
            return uri
    return None


# ---------------------------------------------------------------------------
# Core conversion
# ---------------------------------------------------------------------------

def pdf_to_markdown(pdf_path: Path) -> str:
    pdf_path = pdf_path.resolve()

    fitz_doc = fitz.open(str(pdf_path))
    pl_doc = pdfplumber.open(str(pdf_path))

    repeating = _find_repeating_lines(fitz_doc)

    blocks_out: list[str] = []

    for page_num in range(len(fitz_doc)):
        fitz_page = fitz_doc[page_num]
        pl_page = pl_doc.pages[page_num]

        # Tables via pdfplumber
        tables = pl_page.find_tables()
        rendered_tables: dict[tuple, str] = {}
        for t in tables:
            key = tuple(round(v, 1) for v in t.bbox)
            rendered_tables[key] = _table_to_md(t.extract())

        blocks = fitz_page.get_text("dict", flags=fitz.TEXT_PRESERVE_WHITESPACE)["blocks"]
        body_size = _dominant_body_size(blocks)
        links = _page_links(fitz_page)

        emitted_table_keys: set[tuple] = set()
        prev_text = ""

        for block in blocks:
            if block.get("type") == 1:
                blocks_out.append("*[image]*")
                continue

            block_bbox = block["bbox"]

            # Route into table renderer if bbox overlaps a detected table
            in_table_key = None
            for key in rendered_tables:
                if _bbox_overlaps(block_bbox, key):
                    in_table_key = key
                    break

            if in_table_key is not None:
                if in_table_key not in emitted_table_keys:
                    blocks_out.append(rendered_tables[in_table_key])
                    emitted_table_keys.add(in_table_key)
                continue

            # Build text block from spans
            block_lines: list[str] = []
            for line in block.get("lines", []):
                span_items: list[tuple] = []  # (styled_text, uri_or_None)
                max_size = 0.0
                skip_line = False
                for span in line.get("spans", []):
                    raw = _clean(span.get("text", ""))
                    if not raw:
                        continue

                    # Skip lines that are repeating headers/footers or page numbers
                    if raw in repeating or _FOOTER_RE.match(raw):
                        skip_line = True
                        break

                    size = span.get("size", body_size)
                    flags = span.get("flags", 0)
                    max_size = max(max_size, size)

                    styled = raw
                    if flags & 2**4:   # bold
                        styled = f"**{styled}**"
                    if flags & 2**1:   # italic
                        styled = f"*{styled}*"

                    uri = _link_for_span(span.get("bbox"), links)
                    span_items.append((styled, uri))

                if skip_line or not span_items:
                    continue

                # Merge consecutive spans sharing a link URI, wrap as [text](uri)
                parts: list[str] = []
                k = 0
                while k < len(span_items):
                    text_k, uri_k = span_items[k]
                    if uri_k:
                        run = [text_k]
                        m = k + 1
                        while m < len(span_items) and span_items[m][1] == uri_k:
                            run.append(span_items[m][0])
                            m += 1
                        parts.append(f"[{' '.join(run)}]({uri_k})")
                        k = m
                    else:
                        parts.append(text_k)
                        k += 1

                combined = " ".join(parts)

                # Check full combined line against repeating set
                bare = _clean(combined.replace("**", "").replace("*", ""))
                if bare in repeating or _FOOTER_RE.match(bare):
                    continue

                level = _heading_level(max_size, body_size)
                if level:
                    combined = "#" * level + " " + bare
                block_lines.append(combined)

            if not block_lines:
                continue

            block_text = _merge_adjacent_links("\n".join(block_lines))

            # Bullet / numbered list normalisation
            first_line = block_lines[0]
            if re.match(r"^[•·‣▪▸\-–—]\s+", first_line):
                block_text = re.sub(r"^[•·‣▪▸\-–—]\s+", "- ", block_text, flags=re.MULTILINE)
            elif re.match(r"^\d+[\.\)]\s+", first_line):
                block_text = re.sub(r"^(\d+[\.\)])\s+", r"\1. ", block_text, flags=re.MULTILINE)

            # Skip exact duplicate of previous block
            if block_text.strip() == prev_text.strip():
                continue
            prev_text = block_text

            blocks_out.append(block_text)

        # Page break separator (not after last page)
        if page_num < len(fitz_doc) - 1:
            blocks_out.append("---")

    fitz_doc.close()
    pl_doc.close()

    # Merge tables that were split across page boundaries
    blocks_out = _merge_split_tables(blocks_out)

    # Join and collapse excessive blank lines
    result = "\n\n".join(b for b in blocks_out if b.strip())
    result = re.sub(r"\n{3,}", "\n\n", result)
    return result + "\n"


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def resolve_pdfs(args) -> list[Path]:
    pdfs: list[Path] = []
    if args.files:
        for f in args.files:
            p = Path(f)
            if not p.exists():
                print(f"[warn] not found, skipping: {p}", file=sys.stderr)
            elif p.suffix.lower() != ".pdf":
                print(f"[warn] not a PDF, skipping: {p}", file=sys.stderr)
            else:
                pdfs.append(p)
    if args.dir:
        d = Path(args.dir)
        if not d.is_dir():
            print(f"[error] --dir is not a directory: {d}", file=sys.stderr)
            sys.exit(1)
        glob = "**/*.pdf" if args.recursive else "*.pdf"
        pdfs.extend(sorted(d.glob(glob)))
    return pdfs


def main():
    parser = argparse.ArgumentParser(
        description="Convert PDF(s) to Markdown.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("files", nargs="*", help="PDF file(s) to convert")
    parser.add_argument("--dir", help="Convert all PDFs in a directory")
    parser.add_argument("--recursive", action="store_true", help="Recurse into subdirectories (with --dir)")
    parser.add_argument(
        "--out",
        help="Output directory (default: r&d/converted-md/ next to this script)",
    )
    args = parser.parse_args()

    if not args.files and not args.dir:
        parser.print_help()
        sys.exit(1)

    pdfs = resolve_pdfs(args)
    if not pdfs:
        print("[error] no PDF files found.", file=sys.stderr)
        sys.exit(1)

    default_out = Path(__file__).parent / "converted-md"
    out_dir = Path(args.out) if args.out else default_out
    out_dir.mkdir(parents=True, exist_ok=True)

    ok = 0
    for pdf in pdfs:
        dest = out_dir / (pdf.stem + ".md")
        try:
            print(f"  converting: {pdf.name} → {dest.name} ... ", end="", flush=True)
            md = pdf_to_markdown(pdf)
            dest.write_text(md, encoding="utf-8")
            print(f"done  ({len(md):,} chars, {dest})")
            ok += 1
        except Exception as e:
            print(f"FAILED — {e}", file=sys.stderr)

    print(f"\n{ok}/{len(pdfs)} converted.")


if __name__ == "__main__":
    main()
